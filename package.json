{
  "name": "jintia-desktop",
  "version": "1.1.1",
  "type": "module",
  "description": "Aplicación de escritorio de Jintia para configurar el entorno, organizar cursos e instalar Jintia Skill",
  "author": "Charlie Cárdenas Toledo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CharlieCardenasToledo/jintia-desktop.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:web": "vite --mode mock",
    "build": "vite build",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "docs:check": "node scripts/check-docs.mjs",
    "skill:verify": "node --test tests/skill-verify.test.mjs",
    "test": "node --test tests/static-contracts.test.mjs tests/onboarding-v4.test.mjs tests/claude-provider.test.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "lucide": "1.26.0",
    "marked": "^18.0.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "esbuild": "^0.28.1",
    "vite": "8.1.5"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
