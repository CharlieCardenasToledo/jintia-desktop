{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos por defecto para Jintia Desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-maximize",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-start-dragging",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "claude://*" },
        { "url": "codex://*" },
        { "url": "https://github.com/CharlieCardenasToledo" },
        { "url": "https://github.com/CharlieCardenasToledo/jintia-desktop" },
        { "url": "https://github.com/CharlieCardenasToledo/jintia-desktop/issues" },
        { "url": "https://github.com/CharlieCardenasToledo/jintia-desktop/blob/main/LICENSE" },
        { "url": "https://github.com/CharlieCardenasToledo/jintia-desktop/blob/main/PRIVACY.md" },
        { "url": "https://notebook.google.com/" }
      ]
    }
  ]
}
